{
  "name": "ChombuTar",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node db/migrate.js",
    "db:migrate:completion": "node db/migrate.js --completion",
    "db:migrate:live": "node db/migrate.js --live",
    "check:api": "node scripts/check-api.mjs",
