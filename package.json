    "react-router-dom": "^6.26.0",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.58.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5"
  },
  "engines": {
    "node": ">=20"
