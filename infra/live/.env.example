# Copy to infra/live/.env on a persistent Linux VPS, then edit privately.
# DNS A/AAAA record must point LIVE_MEDIA_HOST to this server.
LIVE_MEDIA_HOST=live.your-domain.com
LIVE_APP_ORIGIN=https://your-app.vercel.app
LIVE_MEDIA_AUTH_URL=https://your-app.vercel.app/api/live?media_auth=1
# The public IP or DNS hostname announced in WebRTC ICE candidates.
LIVE_WEBRTC_ADDITIONAL_HOSTS=live.your-domain.com
# Keep raw HTTP media ports bound to localhost; Caddy exposes HTTPS instead.
LIVE_HLS_PORT=127.0.0.1:8888
LIVE_WHIP_PORT=127.0.0.1:8889
LIVE_ICE_UDP_PORT=8189
# Optional real-time interaction relay; also set the same value in Vercel.
LIVE_REALTIME_SECRET=replace_with_unique_long_random_secret
LIVE_REALTIME_PORT=127.0.0.1:8787
