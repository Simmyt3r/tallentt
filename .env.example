# Public client variables
VITE_APP_NAME=ChombuTar
VITE_APP_URL=https://your-app.vercel.app
VITE_CLOUDINARY_CLOUD_NAME=j1nochxj
VITE_CLOUDINARY_UPLOAD_PRESET=chombutar_unsigned_preset
VITE_CLOUDINARY_FOLDER=chombutar_hats
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_test_key

# ChombuTar Live client configuration
# Interaction events only; audio/video never travels over this WebSocket.
VITE_LIVE_WS_URL=wss://your-live-realtime.example.com/live
# Optional WebRTC ICE/TURN config as a JSON array. TURN credentials delivered
# to browsers are necessarily client-visible; prefer short-lived credentials.
VITE_LIVE_ICE_SERVERS_JSON=[]

# Server-only variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
JWT_SECRET=replace_with_a_64_character_random_secret
NIN_HASH_SECRET=replace_with_a_different_64_character_random_secret
PAYSTACK_SECRET_KEY=sk_live_or_test_key

# ChombuTar Live media: self-hosted MediaMTX behind HTTPS/TLS.
# Leave all three blank to use the temporary Vercel/serverless fallback.
# Once a VPS is available, set all three together and Live switches to MediaMTX automatically.
LIVE_MEDIA_SERVER_URL=
LIVE_WHIP_URL=
LIVE_HLS_BASE_URL=
# MediaMTX external HTTP auth callback. Point this at the deployed ChombuTar API.
LIVE_MEDIA_AUTH_URL=https://your-app.vercel.app/api/live?media_auth=1
# Used by the Docker deployment for CORS/origin checks.
LIVE_APP_ORIGIN=https://your-app.vercel.app
LIVE_WEBRTC_ADDITIONAL_HOSTS=your-media.example.com

# ChombuTar Live interaction relay. The API publishes events over HTTP;
# browsers receive them over WebSocket. Keep the shared secret server-only.
LIVE_REALTIME_PUBLISH_URL=https://your-live-realtime.example.com/events
LIVE_REALTIME_SECRET=replace_with_a_64_character_random_secret
# 0 = no ChombuTar fee. 1000 = 10.00%. Server is authoritative.
LIVE_PLATFORM_FEE_BPS=0

# Cloudinary server credentials
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@j1nochxj
CLOUDINARY_CLOUD_NAME=j1nochxj
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
