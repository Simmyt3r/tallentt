# Public client variables
VITE_APP_NAME=ChombuTar
VITE_APP_URL=https://your-app.vercel.app
VITE_CLOUDINARY_CLOUD_NAME=j1nochxj
VITE_CLOUDINARY_UPLOAD_PRESET=chombutar_unsigned_preset
VITE_CLOUDINARY_FOLDER=chombutar_hats
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_test_key

# Server-only variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
JWT_SECRET=replace_with_a_64_character_random_secret
NIN_HASH_SECRET=replace_with_a_different_64_character_random_secret
PAYSTACK_SECRET_KEY=sk_live_or_test_key

# ChombuTar Live (Cloudflare Stream)
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=replace_with_stream_write_api_token
# 0 = no ChombuTar fee. 1000 = 10.00%. Server is authoritative.
LIVE_PLATFORM_FEE_BPS=0

# Cloudinary server credentials
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@j1nochxj
CLOUDINARY_CLOUD_NAME=j1nochxj
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
